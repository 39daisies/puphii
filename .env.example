# Copy to .env.local (git-ignored) or set as EAS environment variables.
# RevenueCat PUBLIC SDK keys only: RevenueCat dashboard > Project settings > API keys.
# Never put a secret key (sk_...) here: every EXPO_PUBLIC_ value is compiled into the app.

# App Store (appl_...) and Google Play (goog_...) keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# RevenueCat Test Store key (test_...), for simulated purchases in development builds only.
# Release builds ignore it and never contain it. Leave empty to use the store keys above.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
